{
  "name": "shadow-music-bot",
  "version": "1.0.0",
  "description": "Private Jockie-style Discord music bot that follows its owner between voice channels.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "bot:install": "node scripts/service.js install",
    "bot:uninstall": "node scripts/service.js uninstall",
    "bot:start": "node scripts/service.js start",
    "bot:stop": "node scripts/service.js stop",
    "bot:restart": "node scripts/service.js restart",
    "bot:status": "node scripts/service.js status",
    "postinstall": "node scripts/install-ytdlp.js",
    "install-ytdlp": "node scripts/install-ytdlp.js",
    "setup-server": "node scripts/setup-server.js",
    "nettest": "node scripts/nettest.js"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
